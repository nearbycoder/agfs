{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agfs-cimd-egress",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-06",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "rules": [{ "type": "Text", "globs": ["**/*.txt"], "fallthrough": true }],
  "containers": [
    {
      "class_name": "MetadataContainer",
      "image": "docker.io/library/node@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205",
      "max_instances": 1,
      "instance_type": "lite",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "METADATA", "class_name": "MetadataContainer" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MetadataContainer"] }],
}
