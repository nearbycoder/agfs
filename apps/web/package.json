{
  "name": "@agfs/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && tsc --noEmit",
    "build:production": "pnpm --workspace-root test && CLOUDFLARE_ENV=production vite build && tsc --noEmit",
    "cf-typegen": "wrangler types",
    "deploy:production": "pnpm build:production && CLOUDFLARE_ENV=production wrangler deploy",
    "deploy:preview": "pnpm build && wrangler deploy",
    "dev": "CI=1 wrangler d1 migrations apply agfs-db --local && vite dev",
    "d1:migrate:local": "CI=1 wrangler d1 migrations apply agfs-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply agfs-db --remote --env production",
    "preview": "vite preview",
    "r2:cors:production": "wrangler r2 bucket cors set agfs-files --file ./cloudflare/r2-cors.production.json --force",
    "test": "vitest run --passWithNoTests --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agfs/contracts": "workspace:*",
    "@agfs/db": "workspace:*",
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-start": "^1.168.49",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "wrangler": "^4.129.0"
  }
}
