{
  "name": "agfs-dev",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r typecheck",
    "cli": "pnpm --filter @agfs/cli build && node packages/cli/dist/index.js",
    "dev": "pnpm --filter @agfs/web dev",
    "d1:migrate:local": "pnpm --filter @agfs/web d1:migrate:local",
    "deploy:production": "pnpm --filter @agfs/web run deploy:production",
    "d1:migrate:remote": "pnpm --filter @agfs/web d1:migrate:remote",
    "r2:cors": "pnpm --filter @agfs/web r2:cors:production",
    "test": "pnpm -r test",
    "security:check": "pnpm audit --audit-level low && pnpm test && pnpm build && pnpm check"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
